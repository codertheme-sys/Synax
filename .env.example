# Synax production — synax.live
# Copy to .env.local for local dev; set same keys in Vercel → Settings → Environment Variables

NEXT_PUBLIC_SITE_URL=https://synax.live

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=support@synax.live
SMTP_PASSWORD=your_mailbox_password
SMTP_PASS=your_mailbox_password
SMTP_FROM=support@synax.live

CRON_SECRET=your_cron_secret
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
